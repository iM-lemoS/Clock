<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets adb create test alarms without touching the UI (e.g. while
             locked). Protected by DUMP, which only the shell and the system hold. -->
        <receiver
            android:name=".debug.DebugCommandsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.imlemos.clock.debug.TEST_ALARM" />
                <action android:name="io.github.imlemos.clock.debug.DELETE_ALL_ALARMS" />
                <action android:name="io.github.imlemos.clock.debug.SET_NOTICES" />
                <action android:name="io.github.imlemos.clock.debug.SET_AUDIO_OUTPUT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
