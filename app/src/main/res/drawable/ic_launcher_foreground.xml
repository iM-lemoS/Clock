<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon: a smoky Liquid Glass ring around a black dial, white hands at 10:10 and a red
  second hand; transparent around the ring.
  Glass is drawn with gradients only (launcher icons cannot blur). Inside the 66dp safe zone.
  Concept from a Codex image exploration, vectorised by hand.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled so the ring reaches the edge of the visible icon: launchers choose the mask shape,
         so the ring itself becomes the border and little is left around it. -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="1.11" android:scaleY="1.11">
    <!-- The dial inside the ring stays black; around the ring the icon is transparent. -->
    <path
        android:fillColor="#000000"
        android:pathData="M82,54 A28,28 0 1,1 26,54 A28,28 0 1,1 82,54 Z" />
    <!-- The glass ring: bright edges, darker in the middle of its thickness, like a thick lens. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M86,54 A32,32 0 1,1 22,54 A32,32 0 1,1 86,54 Z M81.5,54 A27.5,27.5 0 1,1 26.5,54 A27.5,27.5 0 1,1 81.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="32"
                android:type="radial">
                <item android:color="#E6BFC3C7" android:offset="0.8594" />
                <item android:color="#E632363A" android:offset="0.9031" />
                <item android:color="#E65A6065" android:offset="0.94" />
                <item android:color="#E6DADDE0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Specular rim on both edges, brightest at the top left. -->
    <path
        android:pathData="M86,54 A32,32 0 1,1 22,54 A32,32 0 1,1 86,54 Z"
        android:strokeWidth="1">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="29"
                android:startY="25"
                android:endX="79"
                android:endY="84"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#F2FFFFFF" android:offset="0.25" />
                <item android:color="#3DFFFFFF" android:offset="0.55" />
                <item android:color="#75FFFFFF" android:offset="0.8" />
                <item android:color="#CCFFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M81.5,54 A27.5,27.5 0 1,1 26.5,54 A27.5,27.5 0 1,1 81.5,54 Z"
        android:strokeWidth="0.65">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="29"
                android:startY="25"
                android:endX="79"
                android:endY="84"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#F2FFFFFF" android:offset="0.25" />
                <item android:color="#3DFFFFFF" android:offset="0.55" />
                <item android:color="#75FFFFFF" android:offset="0.8" />
                <item android:color="#CCFFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Hour and minute hands at 10:10. -->
    <path
        android:pathData="M40,44 L54,54 L72,42"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The red second hand. -->
    <path
        android:pathData="M54,54 V76"
        android:strokeColor="#E0282E"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />
    </group>
</vector>
